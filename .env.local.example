# Supabase
# Find these in your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Secret Key (SERVER-SIDE ONLY — never expose to client)
# Used for admin operations: creating users, running seed scripts.
SUPABASE_SECRET_KEY=your-secret-key

# Admin Bootstrap (optional — seed-admin.ts uses defaults if not set)
# ADMIN_EMAIL=admin@irtiqa.ai
# ADMIN_PASSWORD=            # default: revenuepartner@irtiqa.admin
# ADMIN_NAME=Administrator

# QA Seed (optional — seed-qa.ts uses this if set)
# If omitted, seed-qa.ts generates a random password and prints it once.
# QA_PARTNER_PASSWORD=

# Program Timezone (optional — defaults to "Asia/Kolkata")
# All program day and business date calculations use this timezone.
# PROGRAM_TIMEZONE=Asia/Kolkata
