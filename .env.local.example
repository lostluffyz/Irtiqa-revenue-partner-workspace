# Supabase
# Find these in your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Secret Key (SERVER-SIDE ONLY — never expose to client)
# Used for admin operations: creating users, running seed scripts.
SUPABASE_SECRET_KEY=your-secret-key

# Admin Bootstrap (REQUIRED for seed-admin.ts)
# ADMIN_EMAIL=admin@irtiqa.ai
# ADMIN_PASSWORD=            # REQUIRED — no hardcoded default. Must be set in .env.local or Vercel.
# ADMIN_NAME=Administrator

# QA Seed (optional — seed-qa.ts uses this if set)
# If omitted, seed-qa.ts generates a random password and prints it once.
# QA_PARTNER_PASSWORD=

# Program Timezone (optional — defaults to "Asia/Kolkata")
# All program day and business date calculations use this timezone.
# PROGRAM_TIMEZONE=Asia/Kolkata

# Cron Secret (REQUIRED for Vercel Cron Jobs)
# Generate a strong random string and set it in Vercel dashboard environment variables.
# CRON_SECRET=your-strong-random-secret-here

# GitHub Actions Scraper Integration (REQUIRED for Lead Scraper)
# The GitHub token needs "workflow" scope to dispatch workflow_dispatch events.
# SCRAPER_GITHUB_TOKEN=ghp_your-token-here
# SCRAPER_GITHUB_OWNER=lostluffyz
# SCRAPER_GITHUB_REPO=Irtiqa-lead-scraper
# SCRAPER_GITHUB_WORKFLOW=scrape.yml
